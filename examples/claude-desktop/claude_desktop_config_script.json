{
  "mcpServers": {
    "loki-mcp-server": {
      "command": "/path/to/loki-mcp/run-mcp-server.sh",
      "args": [],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "HOME": "/Users/<username>",
        "GOPATH": "/Users/<username>/go",
        "GOMODCACHE": "/Users/<username>/go/pkg/mod",
        "GOCACHE": "/Users/<username>/Library/Caches/go-build",
        "LOKI_URL": "http://localhost:3100"
      },
      "disabled": false,
      "autoApprove": ["loki_query", "loki_label_names", "loki_label_values"]
    }
  }
}
